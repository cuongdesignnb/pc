# hpcomvietnam.vn on aaPanel (Laravel via PHP-FPM 8.3, Nuxt via PM2).
# Non-secret runtime facts only; database and API secrets stay in each .env.
SITE_LABEL=HPCom
BACKEND_DIR=/www/wwwroot/admin.hpcomvietnam.vn
FRONTEND_DIR=/www/wwwroot/hpcomvietnam.vn
API_ORIGIN=https://admin.hpcomvietnam.vn
PUBLIC_ORIGIN=https://hpcomvietnam.vn
PM2_APP=hpcom
FRONTEND_PORT=4455
SOURCE_ROOT=/www/deploy/hpcom-source
BACKUP_ROOT=/www/backups/hpcomvietnam.vn
