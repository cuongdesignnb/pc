# Copy to /www/deploy/sites/<site>.env (or commit as ops/sites/<site>.env)
# and fill in. <site> is the name passed to deploy-aapanel.sh, e.g. "shopabc".
# Only non-secret runtime facts belong here; database and API secrets stay in
# BACKEND_DIR/.env and FRONTEND_DIR/.env.

# Required
BACKEND_DIR=/www/wwwroot/admin.example.vn
FRONTEND_DIR=/www/wwwroot/example.vn
API_ORIGIN=https://admin.example.vn
PUBLIC_ORIGIN=https://example.vn
# PM2 app name and port must be unique per site on this server.
PM2_APP=example
FRONTEND_PORT=4460

# Optional (defaults shown)
# SITE_LABEL=<site>
# SOURCE_ROOT=/www/deploy/<site>-source
# BACKUP_ROOT=/www/backups/<host of PUBLIC_ORIGIN>
# DEPLOY_LOCK=/tmp/<site>-production-deploy.lock
# PHP_BIN=/www/server/php/83/bin/php
# NODE_BIN=/www/server/nodejs/v22.12.0/bin/node
# NPM_BIN=/www/server/nodejs/v22.12.0/bin/npm
# FRONTEND_HOST=0.0.0.0
# RUN_MIGRATIONS=1
# QUEUE_RESTART=1
# BACKEND_SOURCE_URL=https://github.com/cuongdesignnb/pc.git
# FRONTEND_SOURCE_URL=https://github.com/cuongdesignnb/pcfrontend.git
